{
  "name": "@peakelo/server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && swc src -d dist --source-maps --config-file .swcrc",
    "start": "node dist/src/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter @peakelo/shared build && prisma generate && vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@peakelo/engine": "workspace:*",
    "@peakelo/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.3",
    "pino": "^9.14.0",
    "stockfish": "^18.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@swc-node/register": "^1.10.9",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.9.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.1.4"
  }
}
