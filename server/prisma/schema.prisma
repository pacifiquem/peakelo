generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  google
  chesscom
  lichess
}

enum TimeControl {
  bullet
  blitz
  rapid
}

enum GameSource {
  chesscom
  lichess
}

enum TrainingFocus {
  tactics
  positional
  blunders
  openings
  endgames
  rating
  unknown
}

enum ImportStatus {
  idle
  running
  completed
  failed
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts    AuthAccount[]
  sessions    Session[]
  onboarding  Onboarding?
  games       Game[]
  syncStates  SyncState[]
}

model AuthAccount {
  id              String       @id @default(cuid())
  userId          String
  provider        AuthProvider
  providerAccountId String
  username        String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Onboarding {
  userId         String       @id
  trainingFocus  TrainingFocus?
  focusNote      String?
  noteAsked      Boolean      @default(false)
  timeControls   TimeControl[]
  importSource   GameSource?
  importStatus   ImportStatus @default(idle)
  importedCount  Int          @default(0)
  importError    String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id           String      @id @default(cuid())
  userId       String
  source       GameSource
  externalId   String
  timeControl  TimeControl
  playedAt     DateTime
  whiteName    String
  blackName    String
  result       String
  userColor    String
  pgn          String
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, playedAt])
  @@index([userId, timeControl])
}

model SyncState {
  id               String     @id @default(cuid())
  userId           String
  source           GameSource
  username         String
  lastSyncedAt     DateTime?
  lastGamePlayedAt DateTime?
  lastError        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([lastSyncedAt])
}
