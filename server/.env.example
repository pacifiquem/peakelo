NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48

# Local Postgres from the repo docker-compose.yml
DATABASE_URL=postgresql://peakelo@localhost:5432/peakelo
DIRECT_URL=postgresql://peakelo@localhost:5432/peakelo

# Google OAuth — required. See docs/setup/oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lichess OAuth — any unique id works; no secret. See docs/setup/oauth.md
LICHESS_CLIENT_ID=peakelo-local-dev

# Chess.com OAuth is application-only. Leave blank until Chess.com sends endpoints.
# CHESSCOM_CLIENT_ID=
# CHESSCOM_CLIENT_SECRET=
# CHESSCOM_AUTHORIZATION_URL=
# CHESSCOM_TOKEN_URL=
# CHESSCOM_USERINFO_URL=
# CHESSCOM_SCOPE=

# Required by Chess.com's public game API
CHESSCOM_USER_AGENT=Peakelo/0.0.0 (contact: you@example.com)

# Engine pass — optional. Defaults to the npm `stockfish` WASM CLI, then `stockfish` on PATH.
# STOCKFISH_PATH=stockfish
# ENGINE_DEPTH=12
# ENGINE_THREADS=1

# Lesson coach (Mastra + Claude Opus). Empty is fine; lesson routes return 503.
# ANTHROPIC_API_KEY=
# LESSON_MODEL=anthropic/claude-opus-4-6
# Resolved from the process cwd, then the repo root (one level up from server/).
# SLOW_RUN_INDEX_PATH=data/slow-runs/index/positions.json
